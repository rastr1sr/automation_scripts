From a06e5352b87723190d4d1580016738409149d745 Mon Sep 17 00:00:00 2001
From: Dmitry Muhomor <muhomor.dmitry@gmail.com>
Date: Fri, 20 Jan 2023 10:29:58 +0200
Subject: [PATCH] fully disallow installing instant apps

---
 .../com/android/server/pm/PackageInstallerService.java    | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/services/core/java/com/android/server/pm/PackageInstallerService.java b/services/core/java/com/android/server/pm/PackageInstallerService.java
index 687adcce8c05b..cf6de30cceb0b 100644
--- a/services/core/java/com/android/server/pm/PackageInstallerService.java
+++ b/services/core/java/com/android/server/pm/PackageInstallerService.java
@@ -870,12 +870,8 @@ int createSessionInternal(SessionParams params, String installerPackageName,
             }
         }
 
-        if ((params.installFlags & PackageManager.INSTALL_INSTANT_APP) != 0
-                && !PackageManagerServiceUtils.isSystemOrRootOrShell(callingUid)
-                && (snapshot.getFlagsForUid(callingUid) & ApplicationInfo.FLAG_SYSTEM)
-                == 0) {
-            throw new SecurityException(
-                    "Only system apps could use the PackageManager.INSTALL_INSTANT_APP flag.");
+        if ((params.installFlags & PackageManager.INSTALL_INSTANT_APP) != 0) {
+            throw new SecurityException("Installing instant apps is forbidden");
         }
 
         if (params.isStaged && !PackageManagerServiceUtils.isSystemOrRootOrShell(callingUid)) {
