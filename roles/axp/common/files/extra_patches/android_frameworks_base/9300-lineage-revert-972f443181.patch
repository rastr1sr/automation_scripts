From de3afdcb1b984837d4eae3a817a2b6ff71e23482 Mon Sep 17 00:00:00 2001
From: Rastrisr <rastrisr@tutamail.com>
Date: Thu, 15 Oct 2026 01:18:09 +0000
Subject: [PATCH] Revert "Exempt location packages from location indicators"

This reverts commit 972f443181b79986ba37a15485cf6bdedc6641f5.
---
 .../android/permission/PermissionManager.java   | 17 -----------------
 1 file changed, 17 deletions(-)

diff --git a/core/java/android/permission/PermissionManager.java b/core/java/android/permission/PermissionManager.java
index 621d1eaf1..509759fb3 100644
--- a/core/java/android/permission/PermissionManager.java
+++ b/core/java/android/permission/PermissionManager.java
@@ -267,9 +267,6 @@ public final class PermissionManager {
 
     private List<SplitPermissionInfo> mSplitPermissionInfos;
 
-    private static String[] sLocationProviderPkgNames;
-    private static String[] sLocationExtraPkgNames;
-
     /**
      * Creates a new instance.
      *
@@ -1373,16 +1370,6 @@ public final class PermissionManager {
                 pkgNames.add(exemptedPackage);
             }
         }
-        for (String pkgName: sLocationProviderPkgNames) {
-            if (pkgName != null) {
-                pkgNames.add(pkgName);
-            }
-        }
-        for (String pkgName: sLocationExtraPkgNames) {
-            if (pkgName != null) {
-                pkgNames.add(pkgName);
-            }
-        }
         return pkgNames;
     }
 
@@ -1398,10 +1385,6 @@ public final class PermissionManager {
             for (int i = 0; i < EXEMPTED_ROLES.length; i++) {
                 INDICATOR_EXEMPTED_PACKAGES[i] = context.getString(EXEMPTED_ROLES[i]);
             }
-            sLocationProviderPkgNames = context.getResources().getStringArray(
-                    R.array.config_locationProviderPackageNames);
-            sLocationExtraPkgNames = context.getResources().getStringArray(
-                    R.array.config_locationExtraPackageNames);
         }
     }
     /**
