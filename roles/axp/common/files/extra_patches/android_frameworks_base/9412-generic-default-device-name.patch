From e4f309bf80caae09daa5e7ea4a90e8c30ec085b7 Mon Sep 17 00:00:00 2001
From: AXP-fork <noreply@localhost>
Date: Thu, 15 Oct 2026 06:05:25 +0000
Subject: [PATCH] SettingsProvider: use generic default device name

Bluetooth, Wi-Fi Direct and hotspot names default to "Android" instead of
manufacturer + model, so the device model is not broadcast to nearby devices.
Inspired by LeOS (LeanOS) patches_common 0003.

Change-Id: I1eb82ef77f8457d52fb576945b737d821235f16c
---
 packages/SettingsProvider/res/values/defaults.xml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/packages/SettingsProvider/res/values/defaults.xml b/packages/SettingsProvider/res/values/defaults.xml
index 8385703b6..fbb8bcbdb 100644
--- a/packages/SettingsProvider/res/values/defaults.xml
+++ b/packages/SettingsProvider/res/values/defaults.xml
@@ -176,10 +176,10 @@
     <integer name="def_heads_up_enabled">1</integer>
 
     <!-- Default for Settings.Global.DEVICE_NAME $1=MANUFACTURER $2=MODEL-->
-    <string name="def_device_name">%1$s %2$s</string>
+    <string name="def_device_name">Android</string>
 
     <!-- Default for Settings.Global.DEVICE_NAME $1=MODEL-->
-    <string name="def_device_name_simple">%1$s</string>
+    <string name="def_device_name_simple">Android</string>
 
     <!-- Default for Settings.Secure.WAKE_GESTURE_ENABLED -->
     <bool name="def_wake_gesture_enabled">true</bool>
-- 
2.43.0

