From 3433dc4b5169566a4a8d8dfb87a52791de11b913 Mon Sep 17 00:00:00 2001
From: Danny Lin <danny@kdrag0n.dev>
Date: Mon, 5 Oct 2020 21:40:02 -0700
Subject: [PATCH] Allow disabling USB notifications

The persistent "USB connected" notification isn't very useful most of
the time, so let's allow users to disable it to reduce clutter in the
notification shade.

Change-Id: I3704b86fba566412481c8162edfa1e1a1f97347b
Signed-off-by: HeroBuxx <me@herobuxx.me>
---
 .../internal/notification/SystemNotificationChannels.java        | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/java/com/android/internal/notification/SystemNotificationChannels.java b/core/java/com/android/internal/notification/SystemNotificationChannels.java
index 4aebde536..751a9462a 100644
--- a/core/java/com/android/internal/notification/SystemNotificationChannels.java
+++ b/core/java/com/android/internal/notification/SystemNotificationChannels.java
@@ -167,6 +167,7 @@ public class SystemNotificationChannels {
                 USB,
                 context.getString(R.string.notification_channel_usb),
                 NotificationManager.IMPORTANCE_MIN);
+        usb.setBlockable(true);
         channelsList.add(usb);
 
         NotificationChannel foregroundChannel = new NotificationChannel(
-- 
2.43.0

