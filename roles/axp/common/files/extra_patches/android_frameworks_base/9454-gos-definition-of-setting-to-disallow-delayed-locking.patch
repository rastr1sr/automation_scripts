From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Sun, 18 May 2025 03:24:35 +0000
Subject: [PATCH] Definition of setting to disallow delayed locking on user

(applied with fuzz on AXP.OS; original: f2-78bd9528e009.patch)
---
 core/java/android/ext/settings/ExtSettings.java | 3 +++
 core/java/android/provider/Settings.java        | 4 ++++
 2 files changed, 7 insertions(+)

diff --git a/core/java/android/ext/settings/ExtSettings.java b/core/java/android/ext/settings/ExtSettings.java
index cc3c7ec30..f7bd40acb 100644
--- a/core/java/android/ext/settings/ExtSettings.java
+++ b/core/java/android/ext/settings/ExtSettings.java
@@ -45,6 +45,9 @@ public class ExtSettings {
             Setting.Scope.GLOBAL, Settings.Global.ALLOW_DISABLING_HARDENING_VIA_APP_COMPAT_CONFIG,
             defaultBool(R.bool.setting_default_allow_disabling_hardening_via_app_compat_config));
 
+    public static final BoolSetting DISALLOW_DELAYED_LOCKING_ON_USER_STOP = new BoolSetting(
+            Setting.Scope.PER_USER, Settings.Secure.DISALLOW_DELAYED_LOCKING_ON_USER_STOP, false);
+
     private ExtSettings() {}
 
     public static Function<Context, Boolean> defaultBool(@BoolRes int res) {
diff --git a/core/java/android/provider/Settings.java b/core/java/android/provider/Settings.java
index 1e0d0e4bb..8feee476f 100644
--- a/core/java/android/provider/Settings.java
+++ b/core/java/android/provider/Settings.java
@@ -6978,6 +6978,10 @@ public final class Settings {
         @Protected(readWrite = KnownSystemPackage.SETTINGS)
         public static final String CROSS_PROFILE_CLIPBOARD_ACCESS = "cross_profile_clipboard_access";
 
+        /** @hide */
+        @Protected(readWrite = KnownSystemPackage.SETTINGS)
+        public static final String DISALLOW_DELAYED_LOCKING_ON_USER_STOP = "disallow_delayed_locking_on_user_stop";
+
         // ExtSettings END
 
         // NOTE: If you add new settings here, be sure to add them to
