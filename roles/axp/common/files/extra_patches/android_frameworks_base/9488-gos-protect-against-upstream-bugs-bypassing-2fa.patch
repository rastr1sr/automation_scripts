From 8c0a16a6c1f1aac0b69d9105e63b70072141c34b Mon Sep 17 00:00:00 2001
From: Daniel Micay <daniel.micay@grapheneos.org>
Date: Tue, 14 Jan 2025 18:41:55 -0500
Subject: [PATCH] protect against upstream bugs bypassing 2FA

---
 .../systemui/statusbar/phone/BiometricUnlockController.java     | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/BiometricUnlockController.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/BiometricUnlockController.java
index 692a62e68..cd7040cc4 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/BiometricUnlockController.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/BiometricUnlockController.java
@@ -630,7 +630,7 @@ public class BiometricUnlockController extends KeyguardUpdateMonitorCallback imp
                 // conditional is always true. Everything is running in the same thread so not
                 // possible for this implication to be invalidated externally.
                 if (mKeyguardStateController.isUnlocked()) {
-                    return MODE_WAKE_AND_UNLOCK;
+                    return MODE_ONLY_WAKE;
                 }
                 // This is unreachable.
                 return MODE_ONLY_WAKE;
-- 
2.43.0

