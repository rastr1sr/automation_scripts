+// NFC variant of AXP's BluetoothTimeoutPreferenceController (setting consumed by
+// services NfcAutoOff, ported from GrapheneOS ebce750e74 / bf67e682b)
+package com.android.settings.nfc;
+
+import android.content.Context;
+import android.nfc.NfcAdapter;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.bluetooth.BluetoothTimeoutPreferenceController;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.core.PreferenceControllerMixin;
+
+public class NfcTimeoutPreferenceController extends BasePreferenceController implements
+        PreferenceControllerMixin, Preference.OnPreferenceChangeListener {
+    private static final String TAG = "NfcTimeoutPrefCtrl";
+
+    private final String mKey;
+    private final NfcAdapter mNfcAdapter;
+
+    public NfcTimeoutPreferenceController(Context context, String key) {
+        super(context, key);
+        mKey = key;
+        mNfcAdapter = NfcAdapter.getDefaultAdapter(context);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mNfcAdapter != null ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public String getPreferenceKey() {
+        return mKey;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final ListPreference p = (ListPreference) preference;
+        final long timeout = Settings.Global.getLong(mContext.getContentResolver(),
+                Settings.Global.NFC_OFF_TIMEOUT, 0);
+        p.setValue(String.valueOf(timeout));
+        updateSummary(p, timeout);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        try {
+            long value = Long.parseLong((String) newValue);
+            Settings.Global.putLong(mContext.getContentResolver(),
+                    Settings.Global.NFC_OFF_TIMEOUT, value);
+            updateSummary((ListPreference) preference, value);
+        } catch (NumberFormatException e) {
+            Log.e(TAG, "could not persist NFC timeout setting", e);
+        }
+        return true;
+    }
+
+    private void updateSummary(ListPreference p, long timeout) {
+        final CharSequence d = BluetoothTimeoutPreferenceController.getTimeoutDescription(
+                timeout, p.getEntries(), p.getEntryValues());
+        String summary = "";
+        if (d != null) {
+            summary = timeout != 0 ? mContext.getString(R.string.nfc_timeout_summary, d)
+                    : mContext.getString(R.string.nfc_timeout_summary2);
+        }
+        p.setSummary(summary);
+    }
+}
