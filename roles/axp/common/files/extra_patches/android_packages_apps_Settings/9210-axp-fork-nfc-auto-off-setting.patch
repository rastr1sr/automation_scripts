 res/xml/nfc_and_payment_settings.xml          |  8 ++
 .../nfc/NfcTimeoutPreferenceController.java   | 89 +++++++++++++++++++
 3 files changed, 101 insertions(+)
 create mode 100644 src/com/android/settings/nfc/NfcTimeoutPreferenceController.java

diff --git a/res/values/strings.xml b/res/values/strings.xml
index 7fdea0c..d2075d5 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -33,6 +33,10 @@
     <!-- Connected devices screen, setting option summary to change bluetooth timeout -->
     <string name="bluetooth_timeout_summary">Bluetooth will turn off after <xliff:g id="timeout_description">%1$s</xliff:g> if no devices connected</string>
     <string name="bluetooth_timeout_summary2">Do not automatically turn off Bluetooth</string>
+    <!-- NFC screen, auto turn-off timeout (AXP fork) -->
+    <string name="nfc_timeout">Turn off NFC automatically</string>
+    <string name="nfc_timeout_summary">NFC will turn off after <xliff:g id="timeout_description">%1$s</xliff:g></string>
+    <string name="nfc_timeout_summary2">Do not automatically turn off NFC</string>
     <string name="bluetooth_timeout_summary_never">Never</string>
     <string name="bluetooth_timeout_summary_15secs">15 seconds</string>
     <string name="bluetooth_timeout_summary_30secs">30 seconds</string>
diff --git a/res/xml/nfc_and_payment_settings.xml b/res/xml/nfc_and_payment_settings.xml
index 5fb7c69..40b95bb 100644
--- a/res/xml/nfc_and_payment_settings.xml
+++ b/res/xml/nfc_and_payment_settings.xml
@@ -36,6 +36,14 @@
         settings:controller="com.android.settings.nfc.SecureNfcPreferenceController"
         android:summary="@string/nfc_secure_toggle_summary"/>
 
+    <androidx.preference.ListPreference
+        android:key="nfc_timeout"
+        android:title="@string/nfc_timeout"
+        android:summary="@string/summary_placeholder"
+        android:entries="@array/bluetooth_timeout_entries"
+        android:entryValues="@array/bluetooth_timeout_values"
+        settings:controller="com.android.settings.nfc.NfcTimeoutPreferenceController"/>
+
     <Preference
         android:key="default_payment_app"
         android:title="@string/nfc_payment_settings_title"
