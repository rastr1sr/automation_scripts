From e59c1630475b5a2364f825f9b84474a48df50672 Mon Sep 17 00:00:00 2001
From: Oliver Scott <olivercscott@gmail.com>
Date: Tue, 17 Sep 2024 15:20:35 -0400
Subject: [PATCH] Maximum failed passwords for wipe setting

Ported to AXP.OS lineage-22.2 (rhodep fork) from GrapheneOS 04e55f1e591d.

Change-Id: If8eb7b60594b8c3024b644c0a10b7c5d644e0e03
---
 res/values/calyx_arrays.xml      | 20 ++++++++++++++++++++
 res/values/calyx_strings.xml     |  5 +++++
 res/xml/screen_lock_settings.xml |  8 ++++++++
 3 files changed, 33 insertions(+)
 create mode 100644 res/values/calyx_arrays.xml

diff --git a/res/values/calyx_arrays.xml b/res/values/calyx_arrays.xml
new file mode 100644
index 0000000..9eb654b
--- /dev/null
+++ b/res/values/calyx_arrays.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Arrays for features ported from CalyxOS (AXP fork) -->
+<resources>
+    <!-- Screen lock settings. The maximum failed attempts before a device is wiped. These are shown in a list dialog. -->
+    <string-array name="maximum_failed_passwords_for_wipe_entries">
+        <item>@string/bluetooth_timeout_summary_never</item>
+        <item>@string/maximum_failed_passwords_for_wipe_summary_5_attempts</item>
+        <item>@string/maximum_failed_passwords_for_wipe_summary_10_attempts</item>
+    </string-array>
+
+    <!-- Do not translate. -->
+    <string-array name="maximum_failed_passwords_for_wipe_values" translatable="false">
+        <!-- Do not translate. -->
+        <item>0</item>
+        <!-- Do not translate. -->
+        <item>5</item>
+        <!-- Do not translate. -->
+        <item>10</item>
+    </string-array>
+</resources>
diff --git a/res/values/calyx_strings.xml b/res/values/calyx_strings.xml
index b3a04f2..b21337d 100644
--- a/res/values/calyx_strings.xml
+++ b/res/values/calyx_strings.xml
@@ -8,4 +8,9 @@
     <string name="global_vpn_summary">Force all traffic on the device through this VPN, including work profile and other users.</string>
     <string name="global_vpn_summary_on">Force all traffic on the device through this VPN, including work profile and other users. Note: When enabled, you will not be able to use a separate VPN in a work profile or other users</string>
     <string name="global_vpn_summary_any_vpn_active">You need to disable all active VPN connections first to enable this</string>
+    <!-- Screen lock settings -->
+    <string name="maximum_failed_passwords_for_wipe_title">Wipe on failed unlock attempts</string>
+    <string name="maximum_failed_passwords_for_wipe_summary"><xliff:g id="failed_passwords_description">%1$s</xliff:g></string>
+    <string name="maximum_failed_passwords_for_wipe_summary_5_attempts">Erase all data after 5 failed unlock attempts</string>
+    <string name="maximum_failed_passwords_for_wipe_summary_10_attempts">Erase all data after 10 failed unlock attempts</string>
 </resources>
diff --git a/res/xml/screen_lock_settings.xml b/res/xml/screen_lock_settings.xml
index e46d70c..d7187ca 100644
--- a/res/xml/screen_lock_settings.xml
+++ b/res/xml/screen_lock_settings.xml
@@ -65,4 +65,12 @@
         android:title="@string/unlock_scramble_pin_layout_title"
         android:summary="@string/unlock_scramble_pin_layout_summary" />
 
+    <lineageos.preference.LineageSecureSettingListPreference
+        android:key="maximum_failed_passwords_for_wipe"
+        android:title="@string/maximum_failed_passwords_for_wipe_title"
+        android:summary="@string/maximum_failed_passwords_for_wipe_summary"
+        android:entries="@array/maximum_failed_passwords_for_wipe_entries"
+        android:entryValues="@array/maximum_failed_passwords_for_wipe_values"
+        android:defaultValue="0" />
+
 </PreferenceScreen>
-- 
2.43.0

