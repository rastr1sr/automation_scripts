+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+// AXP fork: UI for clipboard auto clear (framework: ClipboardService reads
+// Settings.Secure CLIPBOARD_AUTO_CLEAR_ENABLED / _TIMEOUT; ported from crDroid/CalyxOS)
+package com.android.settings.privacy;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+public class ClipboardAutoClearPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final long DEFAULT_TIMEOUT_MS = 3600000L;
+
+    public ClipboardAutoClearPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    private long currentValue() {
+        final boolean enabled = Settings.Secure.getInt(mContext.getContentResolver(),
+                Settings.Secure.CLIPBOARD_AUTO_CLEAR_ENABLED, 1) == 1;
+        return enabled ? Settings.Secure.getLong(mContext.getContentResolver(),
+                Settings.Secure.CLIPBOARD_AUTO_CLEAR_TIMEOUT, DEFAULT_TIMEOUT_MS) : 0L;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final ListPreference p = (ListPreference) preference;
+        p.setValue(String.valueOf(currentValue()));
+        p.setSummary(p.getEntry());
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final long value = Long.parseLong((String) newValue);
+        Settings.Secure.putInt(mContext.getContentResolver(),
+                Settings.Secure.CLIPBOARD_AUTO_CLEAR_ENABLED, value > 0 ? 1 : 0);
+        if (value > 0) {
+            Settings.Secure.putLong(mContext.getContentResolver(),
+                    Settings.Secure.CLIPBOARD_AUTO_CLEAR_TIMEOUT, value);
+        }
+        final ListPreference p = (ListPreference) preference;
+        p.setValue((String) newValue);
+        p.setSummary(p.getEntry());
+        return true;
+    }
+}
