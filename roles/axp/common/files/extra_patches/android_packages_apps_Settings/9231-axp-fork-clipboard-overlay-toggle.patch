 res/xml/more_security_privacy_settings.xml    |  8 ++++
 .../ClipboardOverlayPreferenceController.java | 47 +++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 src/com/android/settings/privacy/ClipboardOverlayPreferenceController.java

diff --git a/res/values/calyx_strings.xml b/res/values/calyx_strings.xml
index dc51fa5..3676e6e 100644
