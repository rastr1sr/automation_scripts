+++ b/res/values/calyx_strings.xml
@@ -20,4 +20,6 @@
     <string name="clipboard_auto_clear_5min">After 5 minutes</string>
     <string name="clipboard_auto_clear_15min">After 15 minutes</string>
     <string name="clipboard_auto_clear_1hour">After 1 hour</string>
+    <string name="clipboard_overlay_title">Show clipboard preview</string>
