@@ -114,6 +114,14 @@
             settings:controller=
                 "com.android.settings.privacy.ClipboardAutoClearPreferenceController" />
 
+        <!-- Clipboard overlay (AXP fork, from crDroid) -->
+        <SwitchPreference
+            android:key="privacy_clipboard_overlay"
+            android:title="@string/clipboard_overlay_title"
+            android:summary="@string/clipboard_overlay_summary"
