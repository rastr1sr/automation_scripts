         <!-- Strict location redaction -->
         <SwitchPreference
             android:key="privacy_strict_location_redaction"
diff --git a/src/com/android/settings/privacy/ClipboardOverlayPreferenceController.java b/src/com/android/settings/privacy/ClipboardOverlayPreferenceController.java
new file mode 100644
index 0000000..44c608a
--- /dev/null
+++ b/src/com/android/settings/privacy/ClipboardOverlayPreferenceController.java
@@ -0,0 +1,47 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+// AXP fork: toggle for the SystemUI clipboard overlay (Settings.Secure.SHOW_CLIPBOARD_OVERLAY,
+// read by ClipboardListener; ported from crDroid)
+package com.android.settings.privacy;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.core.TogglePreferenceController;
+
+public class ClipboardOverlayPreferenceController extends TogglePreferenceController {
+
+    public ClipboardOverlayPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(),
+                Settings.Secure.SHOW_CLIPBOARD_OVERLAY, 1) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        Settings.Secure.putInt(mContext.getContentResolver(),
+                Settings.Secure.SHOW_CLIPBOARD_OVERLAY, isChecked ? 1 : 0);
+        return true;
+    }
+
+    @Override
+    public boolean isSliceable() {
+        return false;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return NO_RES;
+    }
+}
