diff --git a/src/com/android/settings/display/DozeOnChargePreferenceController.java b/src/com/android/settings/display/DozeOnChargePreferenceController.java
new file mode 100644
index 00000000..b30c3a3e
--- /dev/null
+++ b/src/com/android/settings/display/DozeOnChargePreferenceController.java
@@ -0,0 +1,43 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+// AXP fork: always-on display only while charging (crDroid)
+package com.android.settings.display;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.core.TogglePreferenceController;
+
+public class DozeOnChargePreferenceController extends TogglePreferenceController {
+
+    public DozeOnChargePreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(), "doze_on_charge", 0) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(), "doze_on_charge", isChecked ? 1 : 0);
+    }
+
+    @Override
+    public boolean isSliceable() {
+        return false;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return NO_RES;
+    }
+}
diff --git a/src/com/android/settings/notification/ScreenshotSoundPreferenceController.java b/src/com/android/settings/notification/ScreenshotSoundPreferenceController.java
new file mode 100644
index 00000000..50ee2ff1
--- /dev/null
+++ b/src/com/android/settings/notification/ScreenshotSoundPreferenceController.java
@@ -0,0 +1,43 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+// AXP fork: screenshot shutter sound toggle (AOSPA)
+package com.android.settings.notification;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.core.TogglePreferenceController;
+
+public class ScreenshotSoundPreferenceController extends TogglePreferenceController {
+
+    public ScreenshotSoundPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.System.getInt(mContext.getContentResolver(), "screenshot_shutter_sound", 1) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.System.putInt(mContext.getContentResolver(), "screenshot_shutter_sound", isChecked ? 1 : 0);
+    }
+
+    @Override
+    public boolean isSliceable() {
+        return false;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return NO_RES;
+    }
+}
