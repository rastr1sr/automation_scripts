From a6a0abfdba644238765679466d5e56aa0dcd0bb5 Mon Sep 17 00:00:00 2001
From: Rastrisr <rastrisr@tutamail.com>
Date: Thu, 15 Oct 2026 01:20:22 +0000
Subject: [PATCH] vendor: no make/model in recordings, drop openssh and rsync

Change-Id: Ib2dc7a437f2a0591c41b4fa3cb8d895bd53f04e3
---
 config/common.mk        | 15 ---------------
 config/common_mobile.mk |  2 +-
 2 files changed, 1 insertion(+), 16 deletions(-)

diff --git a/config/common.mk b/config/common.mk
index 50e7ed3..69d1141 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -183,22 +183,7 @@ PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
 PRODUCT_COPY_FILES += \
     vendor/lineage/prebuilt/common/bin/wipe-frp.sh:$(TARGET_COPY_OUT_RECOVERY)/root/system/bin/wipe-frp
 
-# Openssh
-PRODUCT_PACKAGES += \
-    scp \
-    sftp \
-    ssh \
-    sshd \
-    sshd_config \
-    ssh-keygen \
-    start-ssh
-
-PRODUCT_COPY_FILES += \
-    vendor/lineage/prebuilt/common/etc/init/init.openssh.rc:$(TARGET_COPY_OUT_PRODUCT)/etc/init/init.openssh.rc
 
-# rsync
-PRODUCT_PACKAGES += \
-    rsync
 
 # Storage manager
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
diff --git a/config/common_mobile.mk b/config/common_mobile.mk
index cf3a30a..ce222c8 100644
--- a/config/common_mobile.mk
+++ b/config/common_mobile.mk
@@ -87,7 +87,7 @@ PRODUCT_SYSTEM_PROPERTIES += \
 
 # Media
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
-    media.recorder.show_manufacturer_and_model=true
+    media.recorder.show_manufacturer_and_model=false
 
 # SystemUI plugins
 PRODUCT_PACKAGES += \
-- 
2.43.0

