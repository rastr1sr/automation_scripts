From f23d7a012e020c78db9ea72e84f6f0ac2b49af15 Mon Sep 17 00:00:00 2001
From: Rastrisr <rastrisr@tutamail.com>
Date: Fri, 16 Oct 2026 00:59:31 +0000
Subject: [PATCH] vendor: ship owner adb key (PRODUCT_ADB_KEYS)

Recovery adbd then only accepts this key once 'Enable ADB' no longer disables auth.
---
 config/axp-fork/adb_keys | 1 +
 config/common.mk         | 3 +++
 2 files changed, 4 insertions(+)
 create mode 100644 config/axp-fork/adb_keys

diff --git a/config/axp-fork/adb_keys b/config/axp-fork/adb_keys
new file mode 100644
index 0000000..54a50cc
--- /dev/null
+++ b/config/axp-fork/adb_keys
@@ -0,0 +1 @@
 Pepet@THINKPAD
\ No newline at end of file
diff --git a/config/common.mk b/config/common.mk
index 0c1b070..1cf4edd 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -254,6 +254,9 @@ PRODUCT_PACKAGE_OVERLAYS += vendor/crowdin/overlay
 PRODUCT_EXTRA_RECOVERY_KEYS += \
     vendor/lineage/build/target/product/security/lineage
 
+# AXP fork: only the owner's PC may use the adb shell in recovery (and is pre-trusted in Android)
+PRODUCT_ADB_KEYS := vendor/lineage/config/axp-fork/adb_keys
+
 include vendor/lineage/config/version.mk
 
 -include vendor/lineage-priv/keys/keys.mk
-- 
2.43.0

